generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  revokedBy  String?
  deviceId   String
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id              String                    @id @default(uuid())
  phoneNumber     String                    @unique
  firstName       String
  lastName        String
  status          AccountStatus             @default(ACTIVE)
  role            Role                      @default(USER)
  createdAt       DateTime                  @default(now())
  isOnline        Boolean                   @default(false)
  middleName      String
  profileImageUrl String?
  updatedAt       DateTime                  @updatedAt
  clientProfile   ClientProfile?
  conversations   ConversationParticipant[]
  locations       Location[]
  sentMessages    Message[]
  sessions        Session[]
  workerProfile   WorkerProfile?

  @@index([status, isOnline, id])
  @@map("users")
}

model ClientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Location {
  id             String                                @id @default(uuid())
  userId         String
  governmentId   String
  cityId         String
  address        String
  addressNotes   String?
  isMain         Boolean
  isHidden       Boolean                               @default(false)
  pointGeography Unsupported("geography(Point, 4326)")
  city           City                                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  government     Government                            @relation(fields: [governmentId], references: [id], onDelete: Cascade)
  user           User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt

  @@index([pointGeography], map: "idx_locations_point", type: Gist)
  @@index([userId, isMain])
  @@map("locations")
}

model WorkerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  experienceYears    Int      @default(0)
  isInTeam           Boolean  @default(false)
  acceptsUrgentJobs  Boolean  @default(false)
  bio                String?
  createdAt          DateTime @default(now())
  portfolioId        String?  @unique
  updatedAt          DateTime @updatedAt
  rate               Float    @default(-1.0)
  completedJobsCount Int      @default(0)
  workingHoursId     String?  @unique

  occupiedTimeSlots     WorkerOccupiedTimeSlot[]
  Order                 Order[]
  portfolio             Portfolio?
  chosenSpecializations ChosenSpecialization[]
  verification          WorkerVerification?
  badges                WorkerBadge[]
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workGovernments       Government[]             @relation("GovernmentToWorkerProfile")
  workingHours          WorkingHours?            @relation(fields: [workingHoursId], references: [id])
  workerBalance         WorkerBalance?
  payoutMethods         PayoutMethod[]

  @@index([userId], map: "idx_worker_profiles_user_id")
  @@index([acceptsUrgentJobs, userId])
  @@index([rate(sort: Desc), completedJobsCount(sort: Desc)]) // NEW: covers ORDER BY for highestRated sort
  @@index([rate])
  @@index([completedJobsCount])
  @@map("worker_profiles")
}

model WorkingHours {
  id              String @id @default(uuid())
  workerProfileId String @unique

  daysOfWeek     String[]
  startTime      String // e.g., "09:00"
  endTime        String // e.g., "17:00"
  workerProfiles WorkerProfile[]

  @@map("worker_availability")
}

model WorkerOccupiedTimeSlot {
  id              String        @id @default(uuid())
  workerProfileId String
  orderId         String        @unique
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
  @@map("worker_occupied_time_slots")
}

model WorkerVerification {
  id                     String             @id @default(uuid())
  workerProfileId        String             @unique
  idWithPersonalImageUrl String
  idDocumentUrl          String
  reason                 String?
  status                 VerificationStatus @default(PENDING)
  updatedAt              DateTime           @updatedAt
  createdAt              DateTime           @default(now())
  workerProfile          WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@map("verifications")
}

model Portfolio {
  id              String         @id @default(uuid())
  workerProfileId String         @unique
  description     String?
  updatedAt       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  workerProfile   WorkerProfile  @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  projectImages   ProjectImage[]
}

model ProjectImage {
  id          String    @id @default(uuid())
  portfolioId String    @map("projectId")
  imageUrl    String
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model ChosenSpecialization {
  workerProfileId     String
  specializationId    String
  createdAt           DateTime          @default(now())
  subSpecializationId String
  updatedAt           DateTime          @updatedAt
  specialization      Specialization    @relation(fields: [specializationId], references: [id])
  subSpecialization   SubSpecialization @relation(fields: [subSpecializationId], references: [id], onDelete: Cascade)
  workerProfile       WorkerProfile     @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@id([workerProfileId, subSpecializationId])
  @@index([specializationId])
  @@map("chosen_specializations")
}

model Specialization {
  id                 String                 @id @default(uuid())
  name               String
  category           SpecializationCategory
  createdAt          DateTime               @default(now())
  nameAr             String
  ordersCount        Int                    @default(0)
  updatedAt          DateTime               @updatedAt
  choosingWorkers    ChosenSpecialization[]
  subSpecializations SubSpecialization[]

  @@index([name])
  @@map("specializations")
}

model SubSpecialization {
  id                   String                 @id @default(uuid())
  name                 String
  mainSpecializationId String
  createdAt            DateTime               @default(now())
  nameAr               String
  updatedAt            DateTime               @updatedAt
  choosingWorkers      ChosenSpecialization[]
  mainSpecialization   Specialization         @relation(fields: [mainSpecializationId], references: [id], onDelete: Cascade)
  orders               Order[]

  @@index([name])
  @@index([mainSpecializationId]) // NEW: covers the ss.mainSpecializationId lookup in spec fallback filter
  @@map("sub_specializations")
}

model Government {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())
  lat       Float
  long      Float
  nameAr    String
  updatedAt DateTime        @updatedAt
  citys     City[]
  locations Location[]
  workers   WorkerProfile[] @relation("GovernmentToWorkerProfile")

  @@map("governments")
}

model City {
  id           String     @id @default(uuid())
  name         String
  governmentId String
  createdAt    DateTime   @default(now())
  lat          Float
  long         Float
  nameAr       String
  updatedAt    DateTime   @updatedAt
  government   Government @relation(fields: [governmentId], references: [id], onDelete: Cascade)
  locations    Location[]

  @@map("cities")
}

model WorkerBadge {
  id              String        @id @default(uuid())
  workerProfileId String
  badgeType       String
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, badgeType])
  @@map("worker_badges")
}

model Order {
  id                  String      @id @default(uuid())
  title               String
  description         String
  clientProfileId     String
  workerProfileId     String
  locationId          String
  subSpecializationId String
  orderStatus         OrderStatus @default(PENDING)
  workStatus          WorkStatus  @default(PENDING)
  finalPrice          Float?
  startDate           DateTime
  endDate             DateTime?
  isUrgent            Boolean     @default(false)
  rate                Float       @default(-1.0)
  comment             String?
  workStartedAt       DateTime?
  workFinishedAt      DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  clientProfile     ClientProfile           @relation(fields: [clientProfileId], references: [id])
  workerProfile     WorkerProfile?          @relation(fields: [workerProfileId], references: [id])
  location          Location                @relation(fields: [locationId], references: [id])
  subSpecialization SubSpecialization       @relation(fields: [subSpecializationId], references: [id])
  images            OrderImage[]
  occupiedTimeSlot  WorkerOccupiedTimeSlot?
  negotiations      Negotiation[]
  payment           Payment?
  paymentAttempts   PaymentAttempt[]
  escrowHold        EscrowHold?
  disputes          Dispute[]
  paymentIntentions PaymentIntention[]

  @@index([clientProfileId])
  @@index([workerProfileId])
  @@index([orderStatus])
  @@index([locationId])
  @@map("orders")
}

model OrderImage {
  id        String   @id @default(uuid())
  orderId   String
  imageUrl  String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_images")
}

model Negotiation {
  id        String               @id @default(uuid())
  orderId   String
  price     Float
  direction NegotiationDirection
  status    NegotiationStatus    @default(PENDING)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("negotiations")
}

enum OrderType {
  PREVIEW // For a diagnostic visit
  SERVICE // For the actual work
}

enum OrderStatus {
  PENDING
  TIME_SPECIFIED
  PRICE_AGREED
  PAID
  COMPLETED
  CANCELLED
}

enum WorkStatus {
  PENDING
  WAITING_FOR_WORK
  STARTED
  DONE
}

enum NegotiationDirection {
  WORKER_TO_CLIENT
  CLIENT_TO_WORKER
}

enum NegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Role {
  USER
  ADMIN
}

enum Method {
  SMS
  WHATSAPP
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SpecializationCategory {
  ELECTRICITY
  PLUMBING
  AC
  CARPENTRY
  GENERALMAINTENANCE
  PAINTING
  CONSTRUCTION
  CLEANING
  INSTALLATION
  FURNITURETRANSPORT
  DRILLING
  ELECTRICALAPPLIANCES
  DEFAULTCATEGORY
}

enum ConversationRole {
  WORKER
  CLIENT
}

enum MessageType {
  TEXT
  IMAGE
}

enum FlagState {
  PENDING
  REVIEWED
  DISMISSED
}

enum FlagReasonType {
  PHONE_EGYPT
  PHONE_INTERNATIONAL
  URL
  SOCIAL_HANDLE
}

model Conversation {
  id             String   @id @default(uuid())
  messageCounter Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id                        String           @id @default(uuid())
  conversationId            String
  userId                    String
  role                      ConversationRole
  lastReadMessageNumber     Int              @default(0)
  lastReceivedMessageNumber Int              @default(0)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@unique([conversationId, role])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  messageNumber  Int
  content        String
  type           MessageType @default(TEXT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id])
  flagged      FlaggedMessage?

  @@unique([conversationId, messageNumber])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model FlaggedMessage {
  id        String           @id @default(uuid())
  messageId String           @unique
  reasons   FlagReasonType[]
  matches   String[]
  state     FlagState        @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([createdAt])
  @@map("flagged_messages")
}

model FeeRule {
  id            String   @id @default(uuid())
  percentage    Float
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, effectiveFrom])
  @@map("fee_rules")
}

model WebhookEvent {
  id              String             @id @default(uuid())
  providerEventId String             @unique
  provider        String             @default("PAYMOB")
  eventType       String
  status          WebhookEventStatus @default(RECEIVED)
  rawPayload      Json
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  failureReason   String?
  payment         Payment?
  paymentAttempts PaymentAttempt[]

  @@map("webhook_events")
}

model Payment {
  id                  String   @id @default(uuid())
  orderId             String   @unique
  webhookEventId      String   @unique
  idempotencyKey      String   @unique
  externalReferenceId String
  amount              BigInt
  currency            String   @default("EGP")
  createdAt           DateTime @default(now())

  order           Order            @relation(fields: [orderId], references: [id])
  webhookEvent    WebhookEvent     @relation(fields: [webhookEventId], references: [id])
  escrowHold      EscrowHold?
  paymentAttempts PaymentAttempt[]

  @@index([orderId])
  @@map("payments")
}

model PaymentAttempt {
  id                      String               @id @default(uuid())
  orderId                 String
  paymentId               String?
  webhookEventId          String
  status                  PaymentAttemptStatus
  providerResponseCode    String?
  providerResponseMessage String?
  amount                  BigInt
  createdAt               DateTime             @default(now())

  order        Order        @relation(fields: [orderId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])
  webhookEvent WebhookEvent @relation(fields: [webhookEventId], references: [id])

  @@index([orderId])
  @@index([paymentId])
  @@map("payment_attempts")
}

model EscrowHold {
  id                      String           @id @default(uuid())
  orderId                 String           @unique
  paymentId               String           @unique
  totalAmount             BigInt
  workerAmount            BigInt
  platformFee             BigInt
  feeRuleSnapshot         Json
  status                  EscrowHoldStatus @default(HELD)
  escrowReleaseEligibleAt DateTime?
  releasedAt              DateTime?
  idempotencyKey          String           @unique
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([status, escrowReleaseEligibleAt])
  @@map("escrow_holds")
}

// ─── Simplified Transaction Log (replaces double-entry LedgerEntry) ─────

model TransactionLog {
  id            String          @id @default(uuid())
  userId        String
  amount        BigInt
  type          TransactionType
  referenceId   String
  referenceType String
  description   String?
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([referenceId, referenceType])
  @@index([type])
  @@index([createdAt])
  @@map("transaction_logs")
}

// ─── Simple Activity Log (replaces complex FinancialAuditLog) ───────────

model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String
  actionType String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([actionType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum DisputeStatus {
  OPEN
  AWAITING_INFO
  RESOLVED
  DISMISSED
}

enum DisputeResolution {
  REFUND_CLIENT
  FAVOR_WORKER
  PARTIAL_REFUND
  NO_ACTION
}

model WorkerBalance {
  id               String   @id @default(uuid())
  workerProfileId  String   @unique
  totalEarned      BigInt   @default(0)
  withdrawn        BigInt   @default(0)
  pendingWithdraw  BigInt   @default(0)
  onHoldForDispute BigInt   @default(0)
  deductedForDebts BigInt   @default(0)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id])

  @@map("worker_balances")
}

model PayoutMethod {
  id              String           @id @default(uuid())
  workerProfileId String
  methodType      PayoutMethodType
  accountName     String
  accountNumber   String
  bankName        String?
  isDefault       Boolean          @default(false)
  isVerified      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id])

  @@index([workerProfileId])
  @@map("payout_methods")
}

model WithdrawRequest {
  id                   String                @id @default(uuid())
  workerProfileId      String
  workerBalanceId      String
  amount               BigInt
  status               WithdrawRequestStatus @default(PENDING)
  payoutMethodId       String
  payoutMethodSnapshot Json
  idempotencyKey       String                @unique
  adminNotes           String?
  processedBy          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  payoutExecution PayoutExecution?

  @@index([workerProfileId, status])
  @@index([status])
  @@map("withdraw_requests")
}

model PayoutExecution {
  id                  String                @id @default(uuid())
  withdrawRequestId   String                @unique
  amount              BigInt
  status              PayoutExecutionStatus @default(PENDING)
  idempotencyKey      String                @unique
  externalReferenceId String?
  proofOfPaymentUrl   String?
  failureReason       String?
  executedBy          String?
  executedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  withdrawRequest WithdrawRequest @relation(fields: [withdrawRequestId], references: [id])

  @@index([status])
  @@map("payout_executions")
}

model Refund {
  id                       String           @id @default(uuid())
  orderId                  String
  escrowHoldId             String
  amount                   BigInt
  reasonCode               RefundReasonCode
  refundType               String
  originalPaymentReference String
  externalRefundReference  String?
  initiatedBy              String
  idempotencyKey           String           @unique
  notes                    String?
  createdAt                DateTime         @default(now())

  @@index([orderId])
  @@index([escrowHoldId])
  @@map("refunds")
}

model WorkerDebt {
  id                String           @id @default(uuid())
  workerProfileId   String
  refundId          String           @unique
  originalAmount    BigInt
  outstandingAmount BigInt
  status            WorkerDebtStatus @default(OUTSTANDING)
  settledAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([workerProfileId, status])
  @@map("worker_debts")
}

// ─── Dispute System ─────────────────────────────────────────────────────

model Dispute {
  id                      String             @id @default(uuid())
  orderId                 String
  openedBy                String
  status                  DisputeStatus      @default(OPEN)
  resolution              DisputeResolution?
  resolutionNote          String?
  resolvedBy              String?
  resolvedAt              DateTime?
  evidence                Json               @default("[]")
  flaggedMessageIds       String[]
  eventTimeline           Json               @default("[]")
  linkedTransactionLogIds String[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  order    Order            @relation(fields: [orderId], references: [id])
  messages DisputeMessage[]

  @@index([orderId])
  @@index([status])
  @@index([openedBy])
  @@map("disputes")
}

model DisputeMessage {
  id        String   @id @default(uuid())
  disputeId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_messages")
}

model PaymentIntention {
  id               String   @id @default(uuid())
  orderId          String
  specialReference String   @unique
  amount           BigInt?
  createdAt        DateTime @default(now())
  isPaid           Boolean  @default(false)
  order            Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payment_intentions")
}

// ─── Financial Module Enums ──────────────────────────────────────────────

enum EscrowHoldStatus {
  HELD
  RELEASED
  REFUNDED
}

enum PaymentAttemptStatus {
  SUCCESS
  FAILED
}

enum WithdrawRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutExecutionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WorkerDebtStatus {
  OUTSTANDING
  SETTLING
  SETTLED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

enum PayoutMethodType {
  BANK_ACCOUNT
  INSTAPAY
  MOBILE_WALLET
}

enum RefundReasonCode {
  CLIENT_REQUEST
  SERVICE_NOT_DELIVERED
  QUALITY_ISSUE
  DUPLICATE_PAYMENT
  ADMIN_INITIATED
  DISPUTE_RESOLUTION
}
