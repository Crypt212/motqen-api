generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  revokedBy  String?
  deviceId   String
  fcmToken   String?
  lastUsedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@map("sessions")
}

enum AdminRole {
  SUPER_ADMIN
  USER_MANAGEMENT
  FINANCIAL_MONITOR
  ISSUES_MANAGEMENT
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum AdminAuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AdminAuditCategory {
  AUTH
  ADMIN_MANAGEMENT
  USER_MANAGEMENT
  FINANCIAL
  ISSUES
  SUPPORT_CHAT
  REPORT_MODERATION
}

model Admin {
  id              String       @id @default(uuid())
  username        String       @unique
  passwordHash    String
  firstName       String
  lastName        String
  profileImageUrl String?
  role            AdminRole    @default(SUPER_ADMIN)//
  status          AdminStatus  @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sessions        AdminSession[]
  @@map("admins")
}

model AdminSession {
  id         String    @id @default(uuid())
  adminId    String
  token      String    @unique
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  revokedBy  String?
  deviceId   String
  fcmToken   String?
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, isRevoked])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id             String             @id @default(uuid())
  actorAdminId   String?
  actorUsername  String?
  actorRole      AdminRole?
  action         String
  category       AdminAuditCategory
  severity       AdminAuditSeverity
  targetType     String?
  targetId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime           @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([severity])
  @@index([actorAdminId])
  @@index([targetType, targetId])
  @@index([category, createdAt])
  @@map("admin_audit_logs")
}

model User {
  id                     String                    @id @default(uuid())
  phoneNumber            String                    @unique
  firstName              String
  lastName               String
  status                 AccountStatus             @default(ACTIVE)
  role                   Role                      @default(USER)
  createdAt              DateTime                  @default(now())
  isOnline               Boolean                   @default(false)
  middleName             String
  profileImageUrl        String?
  updatedAt              DateTime                  @updatedAt
  clientProfile          ClientProfile?
  conversations          ConversationParticipant[]
  locations              Location[]
  sentMessages           Message[]
  sessions               Session[]
  workerProfile          WorkerProfile?
  lastNotificationReadAt DateTime?
  notifications          Notification[]
  sentNegotiations       Negotiation[]             @relation("NegotiationSender")
  acceptedNegotiations   Negotiation[]             @relation("NegotiationAccepter")
  reports                Report[]                  @relation("ReportsByUser")

  @@index([status, isOnline, id])
  @@map("users")
}

enum NotificationType {
  ORDER_ACCEPTED
  ORDER_CANCELLED
  ORDER_COMPLETED
  NEGOTIATION_OFFER
  NEGOTIATION_ACCEPTED
  NEGOTIATION_REJECTED
  WORK_STARTED
  WORK_DONE
  PAYMENT_REQUIRED
  PAYMENT_RECEIVED
  PAYOUT_COMPLETED
  DISPUTE_OPENED
  DISPUTE_UPDATED
  DISPUTE_RESOLVED
  REFUND_PROCESSED
  WITHDRAW_REQUESTED
  WITHDRAW_APPROVED
  WITHDRAW_REJECTED
  ADMIN_ACTION
  RATING
  NEW_ORDER
  ORDER_RATED
  TEST_NOTIFICATION
}

enum BroadcastTargetRole {
  WORKER
  CLIENT
  ALL
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json
  isSent    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([isSent, createdAt])
  @@map("notifications")
}

model Broadcast {
  id          String               @id @default(uuid())
  type        NotificationType
  title       String
  body        String
  data        Json
  targetRole  BroadcastTargetRole?
  targetGovId String?
  createdAt   DateTime             @default(now())

  @@index([targetRole, createdAt])
  @@index([targetGovId, createdAt])
  @@map("broadcasts")
}

model ClientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Location {
  id             String                                @id @default(uuid())
  userId         String
  governmentId   String
  cityId         String
  address        String
  addressNotes   String?
  isMain         Boolean
  isHidden       Boolean                               @default(false)
  pointGeography Unsupported("geography(Point, 4326)")
  city           City                                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  government     Government                            @relation(fields: [governmentId], references: [id], onDelete: Cascade)
  user           User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt

  @@index([pointGeography], map: "idx_locations_point", type: Gist)
  @@index([userId, isMain])
  @@map("locations")
}

model WorkerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  experienceYears    Int      @default(0)
  isInTeam           Boolean  @default(false)
  acceptsUrgentJobs  Boolean  @default(false)
  bio                String?
  createdAt          DateTime @default(now())
  portfolioId        String?  @unique
  updatedAt          DateTime @updatedAt
  rate               Float    @default(-1.0)
  ratingCount        Int      @default(0)
  completedJobsCount Int      @default(0)

  occupiedTimeSlots     WorkerOccupiedTimeSlot[]
  Order                 Order[]
  proposals             Proposal[]
  portfolio             Portfolio?
  chosenSpecializations ChosenSpecialization[]
  verification          WorkerVerification?
  badges                WorkerBadge[]
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workGovernments       Government[]             @relation("GovernmentToWorkerProfile")

  workerBalance    WorkerBalance?
  payoutMethods    PayoutMethod[]
  withdrawRequests WithdrawRequest[]
  daysWorkingHours DayWorkingHours[]

  @@index([userId], map: "idx_worker_profiles_user_id")
  @@index([acceptsUrgentJobs, userId])
  @@index([rate(sort: Desc), completedJobsCount(sort: Desc)]) // NEW: covers ORDER BY for highestRated sort
  @@index([rate])
  @@index([completedJobsCount])
  @@map("worker_profiles")
}

model DayWorkingHours {
  id              String @id @default(uuid())
  workerProfileId String

  day           Day
  startTime     String // e.g., "09:00"
  endTime       String // e.g., "17:00"
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, day])
  @@map("worker_availability")
}

model WorkerOccupiedTimeSlot {
  id              String        @id @default(uuid())
  workerProfileId String
  orderId         String        @unique
  isConfirmed     Boolean       @default(false)
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
  @@map("worker_occupied_time_slots")
}

model WorkerVerification {
  id                     String             @id @default(uuid())
  workerProfileId        String             @unique
  idWithPersonalImageUrl String
  idDocumentUrl          String
  reason                 String?
  status                 VerificationStatus @default(PENDING)
  assignedDepartment     AdminRole?
  assignedAdminId        String?
  rejectionReasons       VerificationRejectionReason[]
  rejectionNote          String?
  updatedAt              DateTime           @updatedAt
  createdAt              DateTime           @default(now())
  workerProfile          WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([assignedDepartment, status])
  @@index([assignedAdminId])
  @@map("verifications")
}

model Portfolio {
  id              String         @id @default(uuid())
  workerProfileId String         @unique
  description     String?
  updatedAt       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  workerProfile   WorkerProfile  @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  projectImages   ProjectImage[]
}

model ProjectImage {
  id          String    @id @default(uuid())
  portfolioId String    @map("projectId")
  imageUrl    String
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model ChosenSpecialization {
  workerProfileId     String
  specializationId    String
  createdAt           DateTime          @default(now())
  subSpecializationId String
  updatedAt           DateTime          @updatedAt
  specialization      Specialization    @relation(fields: [specializationId], references: [id])
  subSpecialization   SubSpecialization @relation(fields: [subSpecializationId], references: [id], onDelete: Cascade)
  workerProfile       WorkerProfile     @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@id([workerProfileId, subSpecializationId])
  @@index([specializationId])
  @@map("chosen_specializations")
}

model Specialization {
  id                 String                 @id @default(uuid())
  name               String
  category           SpecializationCategory
  createdAt          DateTime               @default(now())
  nameAr             String
  ordersCount        Int                    @default(0)
  updatedAt          DateTime               @updatedAt
  choosingWorkers    ChosenSpecialization[]
  subSpecializations SubSpecialization[]

  @@index([name])
  @@map("specializations")
}

model SubSpecialization {
  id                   String                 @id @default(uuid())
  name                 String
  mainSpecializationId String
  createdAt            DateTime               @default(now())
  nameAr               String
  updatedAt            DateTime               @updatedAt
  choosingWorkers      ChosenSpecialization[]
  mainSpecialization   Specialization         @relation(fields: [mainSpecializationId], references: [id], onDelete: Cascade)
  orders               Order[]

  @@index([name])
  @@index([mainSpecializationId]) // NEW: covers the ss.mainSpecializationId lookup in spec fallback filter
  @@map("sub_specializations")
}

model Government {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())
  lat       Float
  long      Float
  nameAr    String
  updatedAt DateTime        @updatedAt
  citys     City[]
  locations Location[]
  workers   WorkerProfile[] @relation("GovernmentToWorkerProfile")

  @@map("governments")
}

model City {
  id           String     @id @default(uuid())
  name         String
  governmentId String
  createdAt    DateTime   @default(now())
  lat          Float
  long         Float
  nameAr       String
  updatedAt    DateTime   @updatedAt
  government   Government @relation(fields: [governmentId], references: [id], onDelete: Cascade)
  locations    Location[]

  @@map("cities")
}

model WorkerBadge {
  id              String        @id @default(uuid())
  workerProfileId String
  badgeType       String
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, badgeType])
  @@map("worker_badges")
}

model Order {
  id                     String      @id @default(uuid())
  referenceNumber        Int         @unique @default(autoincrement())
  orderReference         String?     @unique
  title                  String
  description            String
  clientProfileId        String
  workerProfileId        String?
  locationId             String
  subSpecializationId    String
  orderStatus            OrderStatus @default(PENDING)
  workStatus             WorkStatus  @default(PENDING)
  initialPrice           Float?
  finalPrice             Float?
  startDate              DateTime?
  estimatedDurationHours Int?
  orderMode              OrderMode   @default(DIRECT)
  isUrgent               Boolean     @default(false)
  rate                   Float       @default(-1.0)
  comment                String?
  workStartedAt          DateTime?
  workFinishedAt         DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  clientProfile     ClientProfile           @relation(fields: [clientProfileId], references: [id])
  workerProfile     WorkerProfile?          @relation(fields: [workerProfileId], references: [id])
  location          Location                @relation(fields: [locationId], references: [id])
  subSpecialization SubSpecialization       @relation(fields: [subSpecializationId], references: [id])
  images            OrderImage[]
  occupiedTimeSlot  WorkerOccupiedTimeSlot?
  negotiations      Negotiation[]
  proposals         Proposal[]
  payment           Payment?
  paymentAttempts   PaymentAttempt[]
  escrowHold        EscrowHold?
  disputes          Dispute[]
  paymentIntentions PaymentIntention[]
  reports           Report[]                @relation("ReportContextOrder")

  @@index([clientProfileId])
  @@index([workerProfileId])
  @@index([orderStatus])
  @@index([locationId])
  @@map("orders")
}

model OrderImage {
  id        String   @id @default(uuid())
  orderId   String
  imageUrl  String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_images")
}

model Negotiation {
  id         String               @id @default(uuid())
  orderId    String
  price      Float
  direction  NegotiationDirection
  status     NegotiationStatus    @default(PENDING)
  senderId   String
  acceptedBy String?

  note                   String?
  proposalId             String
  startDate              DateTime
  estimatedDurationHours Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    User      @relation("NegotiationSender", fields: [senderId], references: [id])
  accepter  User?     @relation("NegotiationAccepter", fields: [acceptedBy], references: [id])
  proposal  Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([senderId])
  @@map("negotiations")
}

enum OrderType {
  PREVIEW // For a diagnostic visit
  SERVICE // For the actual work
}

enum OrderStatus {
  PENDING
  OPEN
  PRICE_AGREED
  PAID
  COMPLETED
  CANCELLED
}

enum OrderMode {
  DIRECT
  GLOBAL
}

enum ProposalStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  WITHDRAWN
  DISMISSED
}

model Proposal {
  id              String         @id @default(uuid())
  orderId         String
  workerProfileId String
  status          ProposalStatus @default(PENDING)
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id])
  negotiations  Negotiation[]

  @@unique([orderId, workerProfileId])
  @@index([orderId])
  @@index([workerProfileId])
  @@index([status])
  @@map("proposals")
}

enum WorkStatus {
  PENDING
  WAITING_FOR_WORK
  STARTED
  DONE
}

enum Day {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum NegotiationDirection {
  WORKER_TO_CLIENT
  CLIENT_TO_WORKER
}

enum NegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Role {
  USER
  ADMIN
}

enum Method {
  SMS
  WHATSAPP
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationRejectionReason {
  BLURRY_IMAGE
  EXPIRED_ID
  MISMATCHED_PERSON
  MISSING_DOCUMENT
  INVALID_DOCUMENT
  OTHER
}

enum SpecializationCategory {
  ELECTRICITY
  PLUMBING
  AC
  CARPENTRY
  GENERALMAINTENANCE
  PAINTING
  CONSTRUCTION
  CLEANING
  INSTALLATION
  FURNITURETRANSPORT
  DRILLING
  ELECTRICALAPPLIANCES
  DEFAULTCATEGORY
}

enum ConversationRole {
  WORKER
  CLIENT
}

enum MessageType {
  TEXT
  IMAGE
}

enum FlagState {
  PENDING
  REVIEWED
  DISMISSED
}

enum FlagReasonType {
  PHONE_EGYPT
  PHONE_INTERNATIONAL
  URL
  SOCIAL_HANDLE
}

model Conversation {
  id             String   @id @default(uuid())
  messageCounter Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  reports      Report[]

  @@map("conversations")
}

model ConversationParticipant {
  id                        String           @id @default(uuid())
  conversationId            String
  userId                    String
  role                      ConversationRole
  lastReadMessageNumber     Int              @default(0)
  lastReceivedMessageNumber Int              @default(0)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@unique([conversationId, role])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  messageNumber  Int
  content        String
  type           MessageType @default(TEXT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id])
  flagged      FlaggedMessage?

  @@unique([conversationId, messageNumber])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model FlaggedMessage {
  id        String           @id @default(uuid())
  messageId String           @unique
  reasons   FlagReasonType[]
  matches   String[]
  state     FlagState        @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([createdAt])
  @@map("flagged_messages")
}

model FeeRule {
  id            String   @id @default(uuid())
  percentage    Float
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, effectiveFrom])
  @@map("fee_rules")
}

model WebhookEvent {
  id              String             @id @default(uuid())
  providerEventId String             @unique
  provider        String             @default("PAYMOB")
  eventType       String
  status          WebhookEventStatus @default(RECEIVED)
  rawPayload      Json
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  failureReason   String?
  payment         Payment?
  paymentAttempts PaymentAttempt[]

  @@map("webhook_events")
}

model Payment {
  id                  String   @id @default(uuid())
  orderId             String   @unique
  webhookEventId      String   @unique
  idempotencyKey      String   @unique
  externalReferenceId String
  amount              BigInt
  currency            String   @default("EGP")
  createdAt           DateTime @default(now())

  order           Order            @relation(fields: [orderId], references: [id])
  webhookEvent    WebhookEvent     @relation(fields: [webhookEventId], references: [id])
  escrowHold      EscrowHold?
  paymentAttempts PaymentAttempt[]

  @@index([orderId])
  @@map("payments")
}

model PaymentAttempt {
  id                      String               @id @default(uuid())
  orderId                 String
  paymentId               String?
  webhookEventId          String
  status                  PaymentAttemptStatus
  providerResponseCode    String?
  providerResponseMessage String?
  amount                  BigInt
  createdAt               DateTime             @default(now())

  order        Order        @relation(fields: [orderId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])
  webhookEvent WebhookEvent @relation(fields: [webhookEventId], references: [id])

  @@index([orderId])
  @@index([paymentId])
  @@map("payment_attempts")
}

model EscrowHold {
  id                      String           @id @default(uuid())
  orderId                 String           @unique
  paymentId               String           @unique
  totalAmount             BigInt
  workerAmount            BigInt
  platformFee             BigInt
  feeRuleSnapshot         Json
  status                  EscrowHoldStatus @default(HELD)
  escrowReleaseEligibleAt DateTime?
  releasedAt              DateTime?
  idempotencyKey          String           @unique
  assignedDepartment      AdminRole?
  assignedAdminId         String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([status, escrowReleaseEligibleAt])
  @@index([assignedDepartment, status])
  @@index([assignedAdminId])
  @@map("escrow_holds")
}

// ─── Simplified Transaction Log (replaces double-entry LedgerEntry) ─────

model TransactionLog {
  id            String          @id @default(uuid())
  userId        String
  amount        BigInt
  type          TransactionType
  referenceId   String
  referenceType String
  description   String?
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([referenceId, referenceType])
  @@index([type])
  @@index([createdAt])
  @@map("transaction_logs")
}

// ─── Simple Activity Log (replaces complex FinancialAuditLog) ───────────

model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String
  actionType String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([actionType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum DisputeStatus {
  OPEN
  AWAITING_INFO
  RESOLVED
  DISMISSED
}

enum DisputeResolution {
  REFUND_CLIENT
  FAVOR_WORKER
  PARTIAL_REFUND
  NO_ACTION
}

model WorkerBalance {
  id               String   @id @default(uuid())
  workerProfileId  String   @unique
  totalEarned      BigInt   @default(0)
  withdrawn        BigInt   @default(0)
  pendingWithdraw  BigInt   @default(0)
  onHoldForDispute BigInt   @default(0)
  deductedForDebts BigInt   @default(0)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id])

  @@map("worker_balances")
}

model PayoutMethod {
  id               String            @id @default(uuid())
  workerProfileId  String
  methodType       PayoutMethodType
  accountName      String
  accountNumber    String
  bankName         String?
  isDefault        Boolean           @default(false)
  isVerified       Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  withdrawRequests WithdrawRequest[]
  workerProfile    WorkerProfile     @relation(fields: [workerProfileId], references: [id])

  @@unique([workerProfileId, accountNumber])
  @@index([workerProfileId])
  @@map("payout_methods")
}

model WithdrawRequest {
  id                   String                @id @default(uuid())
  workerProfileId      String
  workerBalanceId      String
  amount               BigInt
  status               WithdrawRequestStatus @default(PENDING)
  payoutMethodId       String
  payoutMethodSnapshot Json
  idempotencyKey       String                @unique
  adminNotes           String?
  processedBy          String?
  assignedDepartment   AdminRole?
  assignedAdminId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  payoutExecution PayoutExecution?
  workerProfile   WorkerProfile    @relation(fields: [workerProfileId], references: [id])
  payoutMethod    PayoutMethod     @relation(fields: [payoutMethodId], references: [id])

  @@index([workerProfileId, status])
  @@index([status])
  @@index([assignedDepartment, status])
  @@index([assignedAdminId])
  @@map("withdraw_requests")
}

model PayoutExecution {
  id                  String                @id @default(uuid())
  withdrawRequestId   String                @unique
  amount              BigInt
  status              PayoutExecutionStatus @default(PENDING)
  idempotencyKey      String                @unique
  externalReferenceId String?
  proofOfPaymentUrl   String?
  failureReason       String?
  executedBy          String?
  executedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  withdrawRequest WithdrawRequest @relation(fields: [withdrawRequestId], references: [id])

  @@index([status])
  @@map("payout_executions")
}

model Refund {
  id                       String           @id @default(uuid())
  orderId                  String
  escrowHoldId             String
  amount                   BigInt
  reasonCode               RefundReasonCode
  refundType               String
  originalPaymentReference String
  externalRefundReference  String?
  initiatedBy              String
  idempotencyKey           String           @unique
  notes                    String?
  assignedDepartment       AdminRole?
  assignedAdminId          String?
  createdAt                DateTime         @default(now())

  @@index([orderId])
  @@index([escrowHoldId])
  @@index([assignedDepartment])
  @@index([assignedAdminId])
  @@map("refunds")
}

model WorkerDebt {
  id                String           @id @default(uuid())
  workerProfileId   String
  refundId          String           @unique
  originalAmount    BigInt
  outstandingAmount BigInt
  status            WorkerDebtStatus @default(OUTSTANDING)
  settledAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([workerProfileId, status])
  @@map("worker_debts")
}

// ─── Dispute System ─────────────────────────────────────────────────────

model Dispute {
  id                      String             @id @default(uuid())
  orderId                 String
  openedBy                String
  status                  DisputeStatus      @default(OPEN)
  assignedDepartment      AdminRole?
  assignedAdminId         String?
  resolution              DisputeResolution?
  resolutionNote          String?
  resolvedBy              String?
  resolvedAt              DateTime?
  evidence                Json               @default("[]")
  flaggedMessageIds       String[]
  eventTimeline           Json               @default("[]")
  linkedTransactionLogIds String[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  order    Order            @relation(fields: [orderId], references: [id])
  messages DisputeMessage[]

  @@index([orderId])
  @@index([status])
  @@index([openedBy])
  @@map("disputes")
}

model DisputeMessage {
  id        String   @id @default(uuid())
  disputeId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_messages")
}

model PaymentIntention {
  id               String   @id @default(uuid())
  orderId          String
  specialReference String   @unique
  amount           BigInt?
  createdAt        DateTime @default(now())
  isPaid           Boolean  @default(false)
  order            Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payment_intentions")
}

// ─── Financial Module Enums ──────────────────────────────────────────────

enum EscrowHoldStatus {
  HELD
  RELEASED
  REFUNDED
}

enum PaymentAttemptStatus {
  SUCCESS
  FAILED
}

enum WithdrawRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutExecutionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WorkerDebtStatus {
  OUTSTANDING
  SETTLING
  SETTLED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

enum PayoutMethodType {
  BANK_ACCOUNT
  INSTAPAY
  MOBILE_WALLET
}

enum RefundReasonCode {
  CLIENT_REQUEST
  SERVICE_NOT_DELIVERED
  QUALITY_ISSUE
  DUPLICATE_PAYMENT
  ADMIN_INITIATED
  DISPUTE_RESOLUTION
}

model Report {
  id              String           @id @default(uuid())
  reporterId      String
  targetType      ReportTargetType
  targetId        String?
  contextOrderId  String?
  conversationId  String?
  problemCategory ProblemCategory
  problemType     ProblemType
  description     String
  status          ReportStatus     @default(PENDING)
  assignedDepartment AdminRole?
  assignedAdminId    String?
  resolvedBy      String?
  retainUntil     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reporter     User          @relation("ReportsByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  contextOrder Order?        @relation("ReportContextOrder", fields: [contextOrderId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  images       ReportImage[]

  @@index([reporterId])
  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

model ReportImage {
  id        String   @id @default(uuid())
  reportId  String
  url       String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_images")
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CANCELLED
}

enum ReportTargetType {
  ORDER
  CHAT_MESSAGE
  WORKER_PROFILE
  CLIENT_PROFILE
}

enum ProblemCategory {
  ORDER_ISSUE
  WORKER_CONDUCT
  CLIENT_CONDUCT
  CHAT_MESSAGE
  OTHER
}

enum ProblemType {
  UNFINISHED_WORK
  PAYMENT_DISPUTE
  NO_SHOW
  PROPERTY_DAMAGE
  UNPROFESSIONAL_BEHAVIOR
  FRAUD
  PAYMENT_FRAUD
  UNREASONABLE_DEMANDS
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  OTHER
}

model IssueNote {
  id             String    @id @default(uuid())
  targetType     String
  targetId       String
  authorAdminId  String
  content        String
  createdAt      DateTime  @default(now())

  @@index([targetType, targetId])
  @@map("issue_notes")
}

model IssueAssignmentHistory {
  id                 String    @id @default(uuid())
  targetType         String
  targetId           String
  previousAdminId    String?
  newAdminId         String?
  previousDepartment AdminRole?
  newDepartment      AdminRole?
  event              String
  note               String?
  actorAdminId       String
  createdAt          DateTime  @default(now())

  @@index([targetType, targetId])
  @@map("issue_assignment_history")
}
